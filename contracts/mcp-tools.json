[
  {
    "name": "search_activities",
    "description": "Search OiAir public activities using its current search API, ranking and filters. Age is inclusive; weekdays use Sunday=0 through Saturday=6, and any selected day may match. Age, day and time must match the same published group. Keep unresolved constraints and unknown availability; results do not confirm a place.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 500
        },
        "locale": {
          "type": "string",
          "enum": [
            "pt-BR",
            "pt-PT",
            "en",
            "ru",
            "es"
          ]
        },
        "filters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "maxLength": 120
            },
            "neighborhood": {
              "type": "string",
              "maxLength": 120
            },
            "age": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18
                },
                {
                  "type": "null"
                }
              ]
            },
            "days": {
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "period": {
              "type": "string",
              "enum": [
                "",
                "manha",
                "tarde",
                "noite"
              ]
            },
            "after17": {
              "type": "boolean"
            },
            "categories": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "danca",
                  "esportes",
                  "artes",
                  "musica",
                  "ciencia",
                  "linguas",
                  "natureza",
                  "projetos"
                ]
              }
            },
            "bounds": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "type": "null"
                }
              ]
            },
            "price": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "operator": {
                      "type": "string",
                      "enum": [
                        "lte",
                        "gte",
                        "eq"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    }
                  },
                  "required": [
                    "operator",
                    "amount",
                    "currency",
                    "unit"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "organization": {
                "type": "string"
              },
              "publishedOffers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "publicationId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "version": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "offeringId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "source": {
                      "type": "string",
                      "const": "organization_confirmation"
                    },
                    "checkedAt": {
                      "type": "string"
                    },
                    "validUntil": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "publicationId",
                    "version",
                    "offeringId",
                    "source",
                    "checkedAt",
                    "validUntil"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "id",
              "organization",
              "publishedOffers"
            ],
            "additionalProperties": {}
          }
        },
        "appliedFilters": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        "queryStatus": {
          "type": "string"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "bookingSemantics": {
          "type": "object",
          "properties": {
            "availability": {
              "type": "string",
              "const": "unknown"
            },
            "bookingMode": {
              "type": "string",
              "const": "request_confirmation"
            },
            "createsRequest": {
              "type": "boolean",
              "const": false
            },
            "reservesSeat": {
              "type": "boolean",
              "const": false
            },
            "requiresOrganizationConfirmation": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "availability",
            "bookingMode",
            "createsRequest",
            "reservesSeat",
            "requiresOrganizationConfirmation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "items",
        "appliedFilters",
        "queryStatus",
        "nextCursor",
        "bookingSemantics"
      ],
      "additionalProperties": {}
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
