                }
              }
            }
          }
        }
      }
    },
    "/api/v1/activity-types": {
      "get": {
        "operationId": "listActivityTypes",
        "summary": "Read activity types with current public organizations",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pt-BR",
                "ru",
                "en",
                "es"
              ],
              "default": "pt-BR"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current public data. Availability is not a reservation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "activityTypes",
                    "validUntil"
                  ],
                  "properties": {
                    "activityTypes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "validUntil": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Organization or current publication unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Search generation or cursor changed. Restart the search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Search cursor expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Current source unavailable. Do not invent a successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Freshness": {
        "type": "object",
        "required": [
          "source",
          "checkedAt",
          "validUntil"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Organization": {
        "type": "object",
        "required": [
          "id",
          "organization"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organization": {
            "type": "string"
          },
          "profileSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "publishedOffers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "Offering": {
        "type": "object",
        "required": [
          "id",
          "organizationId",
          "version",
          "freshness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "ageMinYears": {
            "type": "integer"
          },
          "ageMaxYears": {
            "type": "integer"
          },
          "timezone": {
            "type": "string"
          },
          "schedule": {
            "type": "object",
            "additionalProperties": true
          },
          "availability": {
            "type": "string"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        },
        "additionalProperties": true
      },
      "CatalogResult": {
        "type": "object",
        "required": [
          "items",
          "syncedAt"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          },
          "syncedAt": {
            "type": "string",
            "format": "date-time"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "items",
          "appliedFilters",
          "queryStatus",
          "hasMore",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          },
          "appliedFilters": {
            "type": "object",
            "additionalProperties": true
          },
          "queryStatus": {
            "type": "string"
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "degraded": {
            "type": "boolean"
          },
          "resultScope": {
            "type": "string"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
