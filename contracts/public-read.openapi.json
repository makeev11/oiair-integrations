{
  "openapi": "3.1.0",
  "info": {
    "title": "OiAir Public Read API",
    "version": "1.0.0",
    "description": "Public organizations, search and published group conditions. No private contacts, roster, reservation, payments or request management. Conditions have a source and freshness; published time does not guarantee a place."
  },
  "servers": [
    {
      "url": "https://oiair.com.br"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "API guide",
    "url": "https://oiair.com.br/developers/api/"
  },
  "paths": {
    "/api/v1/search": {
      "get": {
        "operationId": "searchActivities",
        "summary": "Search current public organizations and groups",
        "description": "Age, selected days and time must match the same published group. Results are a bounded shortlist; do not treat the count as exhaustive or availability as confirmed.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 500
            },
            "description": "Activity or group query. Do not include personal data."
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pt-BR",
                "ru",
                "en",
                "es"
              ],
              "default": "pt-BR"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "neighborhood",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "age",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18
            }
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated weekday numbers, 0=Sunday, 6=Saturday. Any selected day may match."
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "manha",
                "tarde",
                "noite"
              ]
            },
            "description": "Morning, afternoon or evening respectively."
          },
          {
            "name": "after17",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Require a published group starting at or after 17:00 in its local timezone."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from the same query, filters and locale."
          }
        ],
        "responses": {
          "200": {
            "description": "Current public data. Availability is not a reservation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Organization or current publication unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Search generation or cursor changed. Restart the search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Search cursor expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Current source unavailable. Do not invent a successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
